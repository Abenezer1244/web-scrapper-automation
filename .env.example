# â”€â”€â”€ Database â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Async URL for FastAPI (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://bridgeleads:changeme@localhost:5432/bridgeleads
# Sync URL for Celery workers + Alembic (psycopg2 driver)
DATABASE_URL_SYNC=postgresql+psycopg2://bridgeleads:changeme@localhost:5432/bridgeleads
# RLS cutover (Phase 3): owner/DDL role for Alembic ONLY. Optional - falls
# back to DATABASE_URL_SYNC when unset (see alembic/env.py). After the
# cutover: DATABASE_URL->bridgeleads_app, DATABASE_URL_SYNC->bridgeleads_system,
# this->the owner/DDL role.
DATABASE_URL_MIGRATE=
POSTGRES_PASSWORD=changeme

TEST_DATABASE_URL=postgresql+asyncpg://bridgeleads:changeme@localhost:5432/bridgeleads_test
TEST_DATABASE_URL_SYNC=postgresql+psycopg2://bridgeleads:changeme@localhost:5432/bridgeleads_test

# â”€â”€â”€ Redis â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REDIS_URL=redis://:changeme@localhost:6379/0
REDIS_PASSWORD=changeme

# â”€â”€â”€ Security â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Must be >= 32 chars. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# â”€â”€â”€ Cloudflare R2 (export storage) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=bridgeleads-exports
R2_PUBLIC_URL=https://exports.bridgeleads.io

# â”€â”€â”€ Stripe â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...
STRIPE_PRICE_AGENCY=price_...
STRIPE_PRODUCT_PRO=prod_...
STRIPE_PRODUCT_BUSINESS=prod_...
STRIPE_PRODUCT_AGENCY=prod_...

# â”€â”€â”€ Email (Resend) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
RESEND_API_KEY=re_...
EMAIL_FROM=leads@bridgeleads.io

# â”€â”€â”€ App â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DEBUG=false
ENVIRONMENT=production
FRONTEND_URL=https://app.bridgeleads.io
ALLOWED_ORIGINS=https://app.bridgeleads.io

# ─── Analytics (Phase 3) ──────────────────────────────────────────────────
# Timezone for dashboard analytics day-grouping (IANA name). Default Pacific.
ANALYTICS_TIMEZONE=America/Los_Angeles

# â”€â”€â”€ Worker Scaling â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Concurrent tasks per worker instance. Each uses ~400-500MB (Playwright/Chromium).
# Railway 8GB plan: 4. Railway 2GB plan: 2.
WORKER_CONCURRENCY=2
# Queue routing: "scrape", "enrichment", or "scrape,enrichment" (default: both)
WORKER_QUEUES=scrape,enrichment

# â”€â”€â”€ Playwright â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
PLAYWRIGHT_HEADLESS=true

# â”€â”€â”€ Scraping â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DEFAULT_TIMEOUT=30
MAX_RETRIES=3
POLITE_DELAY_MS=300
# Hard ceiling for a single server-side file download (bulk county data feeds).
# Bounds memory/disk/network DoS; a response exceeding this aborts and raises.
MAX_DOWNLOAD_BYTES=104857600

# â”€â”€â”€ AI Extraction (Claude API) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096
AI_SCRAPER_ENABLED=false
AI_COST_ALERT_THRESHOLD=10.0

# â”€â”€â”€ Property Data API (Regrid â€” national parcel-to-address lookup) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
REGRID_API_TOKEN=your_regrid_api_token
REGRID_ENABLED=false

# â”€â”€â”€ Free Enrichment (County GIS + AI Assessor) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
GIS_ENRICHMENT_ENABLED=true
AI_ENRICHMENT_ENABLED=true

# â”€â”€â”€ CAPTCHA solving (2Captcha) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CAPTCHA_API_KEY=your_2captcha_api_key
CAPTCHA_ENABLED=false

# â”€â”€â”€ Daily Scrape Cache â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Enable automatic daily county scraping (dispatched at 2 AM UTC)
ENABLE_DAILY_SCRAPE=false
# How many days to keep county_records before purging (weekly cleanup)
RECORD_RETENTION_DAYS=365

# â”€â”€â”€ Logging â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
LOG_LEVEL=INFO

# â”€â”€â”€ Skip Trace (Tracerfy, Sprint 4) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Get your API token from https://tracerfy.com dashboard â†’ Settings â†’ API
# The webhook secret is a 32-byte URL-safe string; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then configure the full webhook URL in Tracerfy account profile:
#   https://api.bridgeleads.io/webhooks/tracerfy/<TRACERFY_WEBHOOK_SECRET>
TRACERFY_API_TOKEN=your_tracerfy_api_token_here
TRACERFY_API_BASE_URL=https://tracerfy.com
TRACERFY_WEBHOOK_SECRET=
SKIP_TRACE_ENABLED=false
SKIP_TRACE_CACHE_DAYS=90
SKIP_TRACE_MAX_BATCHES_PER_TICK=2

# Per-tier entitlement enforcement (county-count + record-type gating). Default
# false = audit/log-only (validator logs would-block but does not 402). Flip to
# true per service (api+worker) ONLY after pricing/UI/copy land + accounts are
# grandfathered. See src/api/entitlements.py.
ENTITLEMENT_ENFORCEMENT=false

# --- Stripe metered billing for skip trace lookups ----------------------
# Create via `python scripts/stripe_setup_skip_trace_billing.py` (idempotent)
STRIPE_PRODUCT_SKIP_TRACE=prod_your_id_here
STRIPE_METER_SKIP_TRACE=mtr_your_meter_id_here
STRIPE_METER_EVENT_NAME_SKIP_TRACE=skip_trace_lookup
STRIPE_PRICE_SKIP_TRACE_PRO=price_your_pro_id_here
STRIPE_PRICE_SKIP_TRACE_BUSINESS_OVERAGE=price_your_business_id_here
STRIPE_PRICE_SKIP_TRACE_AGENCY_OVERAGE=price_your_agency_id_here

# Redis TLS verification (M1 security). Default 'required' verifies the broker
# cert (Upstash uses a public cert). Set 'none' ONLY for a private cert chain.
REDIS_SSL_CERT_REQS=required
# Optional explicit CA bundle path; blank = use certifi's bundle.
REDIS_SSL_CA_CERTS=

# Field-level encryption key for sensitive DB columns (MFA TOTP secret; PII later).
# urlsafe-base64 Fernet key(s), comma-separated (first=encrypt, all=decrypt for rotation).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Blank = derived from SECRET_KEY via HKDF (works, but provision a dedicated key in prod).
FIELD_ENCRYPTION_KEY=

# H3 PII encryption (see docs/superpowers/specs/2026-06-08-h3-pii-encryption-design.md)
# Dedicated, STABLE HMAC key for the User.email blind index. MUST be independent
# of FIELD_ENCRYPTION_KEY (Fernet rotation must not change it, or logins break).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BLIND_INDEX_KEY=
# Set true ONLY after the PII backfill is verified complete (scripts/verify_pii_encryption.py
# prints ALL CLEAR). Strict mode makes decrypt reject any non-ciphertext in-scope value.
PII_ENCRYPTION_STRICT=false
